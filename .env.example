# منفذ الخادم المحلي (Node.js) ورابط الموقع العام
PORT=3000
APP_URL=

# إعدادات البريد الإلكتروني (Gmail SMTP - مطلوب لإرسال رموز OTP وتنبيهات الطلبات)
# استخدم App Password من حساب Google بعد تفعيل التحقق بخطوتين
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ORDER_TO=

# أمان الإدارة والمطورين والجلسات
ADMIN_NOTIFY_EMAIL=
ADMIN_PASSWORD=
DEVELOPER_PRIMARY_EMAIL=
SESSION_SECRET=

# بوابة الدفع Stripe (اختياري)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# التخزين الدائم على Vercel Serverless (Upstash Redis / Vercel KV REST API)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# أصول CORS الإضافية أو رابط API منفصل عند الحاجة
ALLOWED_ORIGINS=
VITE_API_BASE_URL=
